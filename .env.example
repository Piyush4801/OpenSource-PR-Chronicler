# Google Gemini Configuration
# Get your API key from https://aistudio.google.com/
GOOGLE_API_KEY=
# Default Gemini Flash model identifier (e.g. gemini-1.5-flash, gemini-2.0-flash, etc.)
GEMINI_MODEL=gemini-1.5-flash

# GitHub Integration
# Optional personal access token to avoid rate limits when fetching PR files/issues
GITHUB_TOKEN=
# Webhook secret configured in your GitHub repository Webhook settings (used for HMAC SHA-256 signature verification)
GITHUB_WEBHOOK_SECRET=

# SMTP Email Configuration
# The sender email address (e.g. your Gmail or company address)
SMTP_EMAIL=
# SMTP App Password (e.g. 16-character Google App Password with 2FA enabled)
SMTP_APP_PASSWORD=
# SMTP Host (e.g. smtp.gmail.com or mail.smtp2go.com)
SMTP_HOST=smtp.gmail.com
# SMTP Port (587 for STARTTLS or 465 for SSL)
SMTP_PORT=587
# Target recipient email for the PR reflection dispatches
RECIPIENT_EMAIL=
